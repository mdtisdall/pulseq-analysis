# Pulseq sequence file
# Hand-written fixture of pulseq-analysis, not made by a Pulseq tool: the scanner-session inputs
# of task R16 (soft delays, the field of view and its flags NOROT, NOSLC and NOSCL).
# It is outside tests/seqfiles, so the tests of every fixture do not read it.

[VERSION]
major 1
minor 5
revision 1

[DEFINITIONS]
AdcRasterTime 1e-07
BlockDurationRaster 1e-05
GradientRasterTime 1e-05
Name scanner_session
RadiofrequencyRasterTime 1e-06

# Format of blocks:
# NUM DUR RF GX GY GZ ADC EXT
# 1: gx; 2: a soft delay TE; 3: gx, rotated by 90 degrees about z; 4: gx, NOROT 1;
# 5: gy, NOROT 0 and NOSLC 1; 6: gz, NOSCL 1 and NOSLC 0; 7: a soft delay TE;
# 8: a soft delay TR; 9: gx.
[BLOCKS]
1 50 0 1 0 0 0 0
2 10 0 0 0 0 0 7
3 50 0 1 0 0 0 1
4 50 0 1 0 0 0 2
5 50 0 0 2 0 0 3
6 50 0 0 0 3 0 5
7 20 0 0 0 0 0 8
8 30 0 0 0 0 0 9
9 50 0 1 0 0 0 0

# Format of trapezoid gradients:
# id amplitude rise flat fall delay
# ..      Hz/m   us   us   us    us
[TRAP]
1 1000000 100 200 100 50
2 500000 100 200 100 50
3 250000 100 200 100 50

# Format of extension lists:
# id type ref next_id
# next_id of 0 terminates the list
[EXTENSIONS]
1 3 1 0
2 1 1 0
3 1 2 4
4 1 3 0
5 1 4 6
6 1 5 0
7 2 1 0
8 2 2 0
9 2 3 0

# Extension specification for setting labels:
# id set labelstring
extension LABELSET 1
1 1 NOROT
2 0 NOROT
3 1 NOSLC
4 1 NOSCL
5 0 NOSLC

# Extension specification for soft delays:
# id num offset factor hint
extension DELAYS 2
1 0 -100 2 TE
2 0 5000 -1 TE
3 1 0 1 TR

# Extension specification for rotation events:
# id RotQuat0 RotQuatX RotQuatY RotQuatZ
extension ROTATIONS 3
1 0.70710678 0 0 0.70710678

# The C++ reader needs a section after the extensions (D2.3).
[SHAPES]

