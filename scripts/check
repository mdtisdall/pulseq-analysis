#!/usr/bin/env bash
# All the checks that CI runs, in one command. Run it in the devShell:
#
#   nix develop --command scripts/check
#   nix develop --command scripts/check --base origin/main
#
# With --base <ref>, when each file that changed since <ref> is documentation, only the checks
# that read the documentation run (docs_only, below). CI gives the base of the pull request or of
# the push.
set -euo pipefail
cd "$(dirname "$0")/.."

base=""
if [[ $# -gt 0 ]]; then
  if [[ $1 != --base || $# -ne 2 ]]; then
    echo "usage: scripts/check [--base <ref>]" >&2
    exit 2
  fi
  base=$2
fi

# Documentation: each file in docs/, and each Markdown file outside tests/ and packages/ except
# TESTS.md. TESTS.md is checked against the collected tests, and the Markdown files of tests/ and
# packages/ are read by their tests (for example tests/seqfiles/oracle/SOURCES.md).
docs_only() {
  local changed file
  changed=$(git diff --name-only "$1" HEAD) || return 1
  [[ -n $changed ]] || return 1
  while IFS= read -r file; do
    case $file in
      docs/*) ;;
      TESTS.md | tests/* | packages/*) return 1 ;;
      *.md) ;;
      *) return 1 ;;
    esac
  done <<<"$changed"
}

if [[ -n $base ]] && docs_only "$base"; then
  echo "# documentation only (the files changed since $base)"
  git diff --name-only "$base" HEAD | sed 's/^/  /'
  echo
  echo "# uv sync"
  uv sync --frozen
  echo
  echo "# pytest (the tests that read the documentation)"
  # tests/test_interface.py checks the names that README.md, docs/usage.md and
  # docs/implementation.md give;
  # tests/test_documents.py checks the record IDs, the links with an anchor and
  # the tables of the documents that repeat a table of the code.
  uv run pytest -q tests/test_interface.py tests/test_documents.py
  exit 0
fi

# pytest writes the IDs of the tests that it collects to this file, and the
# TESTS.md check reads them, so the tests are collected only one time.
collected_tests="$(mktemp)"
trap 'rm -f "$collected_tests"' EXIT

echo "# uv sync"
uv sync --frozen

echo
echo "# ruff"
uv run ruff check .
uv run ruff format --check .

echo
echo "# import-linter"
# The layers of the package (pyproject.toml, [tool.importlinter]).
uv run lint-imports --no-cache

echo
echo "# pytest"
# The tests argument loads tests/conftest.py before pytest reads its options,
# so --collected-tests-file is known.
uv run pytest -q tests --collected-tests-file "$collected_tests"

echo
echo "# pytest without pypulseq"
# pypulseq is optional: the package's own dependencies, pytest and no dev group. The tests with
# the `pypulseq` marker are left out; a test module that imports pypulseq without the marker
# fails its collection here.
uv run --no-dev --isolated --with pytest pytest -q -m "not pypulseq" tests

echo
echo "# pulseq-cpp-siemens"
# The package of the C++ reader (packages/pulseq-cpp-siemens) is its own uv project, with its
# own lock and virtual environment. It is built from the source of the C++ reader that the
# devShell's PULSEQ_SOURCE_DIR names, and rebuilt on each run. Its tests include the first tier
# of the fuzzing of its checks against pulseq-cpp-oracle-sanitized: the regression corpus and
# 200 seeded files (the full set runs in .github/workflows/pulseq-cpp-siemens-fuzz.yml), and the
# tests of the `cpp-siemens` interpreter, the plugin of pulseq-analysis (P21), which the
# environment installs from this checkout (its group `analysis`; --no-editable makes it a copy,
# so it is reinstalled too). Its test IDs go to the same file, for the TESTS.md check.
package=packages/pulseq-cpp-siemens
uv sync --frozen --project "$package" --no-editable \
  --reinstall-package pulseq-cpp-siemens --reinstall-package pulseq-analysis
uv run --project "$package" --no-sync pytest -q "$package/tests"
uv run --project "$package" --no-sync pytest -q --collect-only "$package/tests" \
  >>"$collected_tests"

echo
echo "# TESTS.md"
uv run python scripts/check_tests_md.py --collected "$collected_tests"

echo
echo "# shellcheck"
shellcheck --severity=warning scripts/check .claude/hooks/block-main-writes.sh
echo "ok    shellcheck"
